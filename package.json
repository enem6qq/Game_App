{
  "name": "wolkenfeste",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "description": "Wolkenfeste – Aufbau-Strategiespiel über den Wolken (Expo + TypeScript).",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
