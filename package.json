    "@testing-library/react-native": "^12.5.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "prettier": "^3.3.0",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.3.0"
