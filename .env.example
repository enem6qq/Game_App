# ────────────────────────────────────────────────────────────────
#  Umgebungsvariablen – Vorlage
#  Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
#  ".env" wird NICHT ins Git eingecheckt (siehe .gitignore).
#
#  Variablen mit dem Präfix EXPO_PUBLIC_ sind im App-Code sichtbar
#  (öffentlich!). Lege dort NIEMALS geheime Schlüssel ab.
# ────────────────────────────────────────────────────────────────

# App
APP_NAME="Wolkenfeste"
APP_ENV="development"        # development | staging | production

# Supabase (Backend: Auth, Datenbank, Storage) – OPTIONAL!
# Das Spiel läuft komplett ohne Backend (Gast-Modus). Trage die Werte
# erst ein, wenn du Online-Funktionen (Konto, Cloud-Spielstand) nutzt.
# Findest du im Supabase-Dashboard unter: Project Settings → API
# EXPO_PUBLIC_SUPABASE_URL="https://dein-projekt.supabase.co"
# EXPO_PUBLIC_SUPABASE_ANON_KEY="dein-anon-key"

# Stripe (Zahlungen)
# Nur der "Publishable Key" gehört in die App. Der geheime Key bleibt
# ausschließlich auf dem Server (Supabase Edge Function).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
